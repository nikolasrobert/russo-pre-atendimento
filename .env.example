# Copie para .env (que nunca vai para o Git) ou cadastre no Netlify:
# Site configuration → Environment variables. Explicação de cada uma em docs/deploy.md.

# Banco (Supabase → Project Settings → API Keys). A chave de serviço fica SÓ no servidor.
SUPABASE_URL=https://ydaiuvqtcmjvqzuiuwyl.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
ESTUDIO_ID=00000000-0000-0000-0000-000000000001
TATUADOR_ID=00000000-0000-0000-0000-000000000101

# Painel
PAINEL_EMAIL=
PAINEL_SENHA_HASH=          # npm run senha -- "sua senha"
SESSAO_SEGREDO=             # texto aleatório longo
PAINEL_DEMO=                # 1 = dados de exemplo em memória, sem Supabase

# Trello (https://trello.com/power-ups/admin → sua integração → Chave de API)
TRELLO_CHAVE=
TRELLO_TOKEN=
TRELLO_SEGREDO=             # "Segredo" da mesma página: confere a assinatura do webhook
TRELLO_QUADRO_ID=           # os 6 abaixo saem do: npm run trello:quadro
TRELLO_QUADRO_URL=
TRELLO_LISTA_NOVAS=
TRELLO_ETIQUETA_QUENTE=
TRELLO_ETIQUETA_MORNA=
TRELLO_ETIQUETA_FRIA=
TRELLO_CALLBACK_URL=        # https://SEU-SITE.netlify.app/api/trello
SESSAO_HORAS_PADRAO=3

# Aviso no WhatsApp pelo n8n
N8N_WEBHOOK_URL=            # https://SEU-N8N/webhook/russo-avisos
AVISO_TOKEN=                # o mesmo valor da credencial Header Auth do n8n
